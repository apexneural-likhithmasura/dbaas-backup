# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# OpenAI/OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Reddit Configuration (Optional)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=your-app-name

# Google Search Configuration (Optional)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# CORS
CORS_ORIGINS=*

# PayPal Configuration
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your-webhook-id

# PayPal URLs - Backend capture endpoint
PAYPAL_RETURN_URL=http://localhost:8000/dbas/api/payments/return
PAYPAL_CANCEL_URL=http://localhost:8000/dbas/api/payments/cancel

# Frontend redirect URLs (after backend processing)
PAYPAL_SUCCESS_REDIRECT=http://localhost:3000/payment/success
PAYPAL_FAILURE_REDIRECT=http://localhost:3000/payment/failure

# Payments
PAYMENT_PROVIDER=paypal
PAYMENTS_CURRENCY=USD
PAYMENTS_DATA_DIR=./data

# Database Configuration (for Trending Topics)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trending_topics
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_SCHEMA=public

